# ---- runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- database (MongoDB 5.0) ----
MONGODB_URI=mongodb://127.0.0.1:27017/vcs

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Token that authorises a socket to join one meeting.
JWT_JOIN_TTL=10m
BCRYPT_ROUNDS=10

# ---- clients ----
# Comma separated origins allowed by CORS (frontend, admin panel).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_PUBLIC_URL=http://localhost:5173

# ---- uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# ---- WebRTC ----
# Comma separated STUN urls. TURN is optional but needed behind symmetric NAT.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
